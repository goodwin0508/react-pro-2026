{
  "name": "lesson-01",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:app": "tsx build-hw/configs/esbuild.app.config.ts",
    "build:app:dev": "tsx build-hw/configs/esbuild.app.config.ts --dev",
    "build:lib": "tsx build-hw/configs/esbuild.lib.config.ts",
    "build:lib:dev": "tsx build-hw/configs/esbuild.lib.config.ts --dev",
    "build:lib:swc": "swc build-hw/lib --config-file build-hw/configs/.swcrc.esm.json --out-dir build-hw/dist/lib-swc/esm --strip-leading-paths && swc build-hw/lib --config-file build-hw/configs/.swcrc.cjs.json --out-dir build-hw/dist/lib-swc/cjs --strip-leading-paths",
    "build:hw": "npm run build:app && npm run build:lib && npm run build:lib:swc",
    "lint": "eslint .",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@reduxjs/toolkit": "^2.13.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.90.0",
    "react-redux": "^9.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.20",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
